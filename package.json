    "test:smoke": "node scripts/smoke-test.js",
    "test:milsim-stress": "node scripts/milsim-stress.js 50 6 90",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "peerjs": "^1.5.5",
